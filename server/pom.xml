<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>de.cau.cs.kieler.lite</groupId><artifactId>parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>sccharts-lite-server</artifactId>
  <description>Shaded, runnable SCCharts language server.</description>
  <dependencies>
    <dependency><groupId>de.cau.cs.kieler.lite</groupId><artifactId>language.server</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build>
    <finalName>sccharts-lite-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                <mainClass>de.cau.cs.kieler.language.server.LanguageServer</mainClass>
              </transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>plugin.properties</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
            </transformers>
            <artifactSet>
              <!-- No Eclipse workspace: the server runs on plain Java and never starts Equinox. The
                   core.runtime/registry/preferences/osgi jars stay on the classpath unstarted because
                   ELK's core.service (KLighD's layout engine) subclasses org.eclipse.core.runtime.Plugin
                   and EMF, Xtext, ELK and KLighD check Platform.isRunning() before touching them. -->
              <excludes>
                <exclude>org.eclipse.platform:org.eclipse.core.resources</exclude>
                <exclude>org.eclipse.platform:org.eclipse.core.expressions</exclude>
                <exclude>org.eclipse.platform:org.eclipse.core.filesystem</exclude>
              </excludes>
            </artifactSet>
            <filters>
              <filter><artifact>*:*</artifact><excludes>
                <exclude>**/*.ecore</exclude><exclude>**/*.genmodel</exclude><exclude>**/*.mwe2</exclude><exclude>**/*.xtext</exclude><exclude>**/*.g</exclude><exclude>**/*._trace</exclude>
                <exclude>**/*.html</exclude><exclude>about*</exclude><exclude>about_files/**</exclude><exclude>plugin.xml</exclude><exclude>schema/**</exclude>
                <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.inf</exclude><exclude>META-INF/MANIFEST.MF</exclude>
                <exclude>META-INF/maven/**</exclude><exclude>META-INF/versions/**</exclude><exclude>OSGI-INF/**</exclude><exclude>OSGI-OPT/**</exclude>
                <exclude>**/*.gif</exclude><exclude>**/*.svg</exclude><exclude>images/**</exclude>
              </excludes></filter>
            </filters>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
